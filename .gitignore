!data/processed/discovery_marks_2026-06-30.csv

# fastText language-ID model (126 MB, downloaded by scripts/download_data.py)
models/

# generated figures
figures/*
!figures/.gitkeep

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
__marimo__/

# OS / editor
.DS_Store
.vscode/
